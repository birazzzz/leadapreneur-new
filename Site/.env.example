# Keystatic CMS (admin/ app only). Never commit real values.
# Created from the GitHub App that Keystatic sets up on first sign-in.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Random string, at least 32 characters. Used to sign editor sessions.
KEYSTATIC_SECRET=
# The GitHub App's URL slug, e.g. leadapreneur-cms
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Optional: owner/name of the content repository. Defaults to birazzzz/leadapreneur-new.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
# Optional: "local" edits files on disk (development only); "github" forces GitHub mode, e.g. to create the GitHub App locally.
NEXT_PUBLIC_KEYSTATIC_STORAGE=

# Team email sign-in. All three are needed; without them only GitHub sign-in is offered.
CMS_ADMIN_EMAIL=
# Generate with: npm run hash-password --workspace admin -- "the password"
CMS_ADMIN_PASSWORD_HASH=
# Fine-grained GitHub token limited to this repository (Contents: read and write).
CMS_GITHUB_TOKEN=
# Optional: branch the editor opens on. Defaults to feature/keystatic-cms.
CMS_DEFAULT_BRANCH=

# Resend — assessment result emails (api/send-result). Never commit the real key.
RESEND_API_KEY=
# Optional: verified sender. Until leadapreneur.com is verified in Resend, the
# default "Leadapreneur <onboarding@resend.dev>" is used, which can only deliver
# to the Resend account owner's own address.
ASSESSMENT_EMAIL_FROM=
