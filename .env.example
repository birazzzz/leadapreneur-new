# Keystatic CMS (admin/ app only). Never commit real values.
# Created from the GitHub App that Keystatic sets up on first sign-in.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Random string, at least 32 characters. Used to sign editor sessions.
KEYSTATIC_SECRET=
# The GitHub App's URL slug, e.g. leadapreneur-cms
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Optional: owner/name of the content repository. Defaults to birazzzz/leadapreneur-new.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
# Optional: "local" edits files on disk (development only); "github" forces GitHub mode, e.g. to create the GitHub App locally.
NEXT_PUBLIC_KEYSTATIC_STORAGE=
